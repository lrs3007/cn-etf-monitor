DATABASE_URL=sqlite:///./data/monitor.db
API_BASE_URL=http://127.0.0.1:8000
# Optional: use a separately provisioned PostgreSQL database.
# DATABASE_URL=postgresql+psycopg://monitor:change-me@localhost:5432/monitor
# Optional: enables index valuation history when your account has permission.
TUSHARE_TOKEN=
# Required only for remote administrative writes, never exposed to the browser.
ADMIN_TOKEN=
# Docker Compose only: use a hex password to avoid URL-encoding ambiguity.
POSTGRES_PASSWORD=
# Local-only Netlify publishing. Never use NEXT_PUBLIC_* for credentials.
# CLI login credentials may also be used by scripts/publish-results.mjs.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
# Enable publishing after successful local web, scheduled, and CLI updates.
CN_MONITOR_PUBLISH=0
